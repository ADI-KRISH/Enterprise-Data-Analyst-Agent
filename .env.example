# Copy to .env and fill in. Never commit .env.

# Postgres container bootstrap (docker-compose only)
POSTGRES_DB=analytics
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
ANALYST_RO_PASSWORD=change-me-ro

# Agent connection — read-only role, SELECT on schema analytics only
DATABASE_URL_RO=postgresql+psycopg://analyst_ro:change-me-ro@localhost:5432/analytics
# Admin connection — used ONLY by database/seed.py, never by agent code
DATABASE_URL_ADMIN=postgresql+psycopg://admin:change-me-admin@localhost:5432/analytics

# LLM provider: OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
LLM_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_MODEL_FAST=qwen/qwen3.8-27b:free
LLM_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_S=60

CHROMA_DIR=./.chroma
# Embeddings: auto = fastembed (downloads its model from Hugging Face on first use), falling back to an
# offline hashed bag-of-words embedder if unavailable. Force one with fastembed | hash.
EMBEDDER=auto
MAX_SQL_ATTEMPTS=3
DEFAULT_ROW_LIMIT=1000
